# TMDB API Key
# Get your free API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_server_only_tmdb_api_key

# Firebase Configuration
# Get these from Firebase Console: https://console.firebase.google.com
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=filminibul.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=filminibul

# Product analytics (disabled until scripts/sql/analytics.sql + analytics_cron.sql are installed)
# Existing server-side database credentials are reused; never prefix these with NEXT_PUBLIC.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
ADMIN_PASSWORD=your_admin_password
ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Catalog translation job (GitHub Actions secret; server only)
OPENAI_API_KEY=your_server_only_openai_key
# Google is the default membership method. Enable email UI only after enabling
# Email/Password in Firebase Authentication.
NEXT_PUBLIC_EMAIL_AUTH_ENABLED=false
# Firebase Console: enable Google under Authentication.
# Authorized domains: filminibul.com, www.filminibul.com, localhost.
